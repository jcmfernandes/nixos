#!/usr/bin/env bash
# Define direnv's `use devenv`. It is not part of direnv's stdlib, so it has
# to be brought in here: relying on a global ~/.config/direnv/direnvrc that
# defines it makes the repo work only on machines already set up that way.
eval "$(devenv direnvrc)"

# age identities for sops decryption. Concatenate multiple stubs into this
# single file.
export SOPS_AGE_KEY_FILE=$PWD/age-identities

use devenv
