+/**
+ * ENABLE_APPLICATION_RECOVERY - recover the PIV login after a failed operation
+ *
+ * If this is enabled and a sign, decipher or key agreement operation fails
+ * while the PIV PIN is no longer verified, the PIV application is re-selected,
+ * the device is checked to have the same serial, the cached PIN is verified
+ * again, and the operation is retried once.
+ *
+ * This allows a long-running PIV application to keep its login while another
+ * process shares the device and selects a different application without
+ * resetting it, e.g. GnuPG's scdaemon with pcsc-shared using OpenPGP.
+ *
+ * The PIN is only re-verified if it has all its tries left, so failed attempts
+ * by anyone stay visible and a stale cached PIN costs at most one try in
+ * total. This needs PIN metadata, so firmware 5.3 or later; older devices are
+ * never recovered.
+ *
+ * Nothing is recovered without a cached PIN (DISABLE_PIN_CACHE turns this off,
+ * and so do PIN policy never keys used without a login), without a readable
+ * serial, on a connection that requested SCP11, or for PIN policy always keys:
+ * the recovery ends with a command that drops the always-authenticated state,
+ * and removing it would let those keys sign with the cached PIN. Only the PIN
+ * is restored, not the MGM_KEY.
+ *
+ * Checking the state sends commands even when nothing is recovered, leaving
+ * PIV selected. ykpiv_auth_deauthenticate() clears the caches, so a logout in
+ * the same process is not undone; a logout by another process is, on the next
+ * failing operation, and the restored login is usable by every process sharing
+ * the device.
+ *
+ * Requires ENABLE_IMPLICIT_TRANSACTIONS, so the checks and the verification
+ * are not interleaved with other processes.
+ *
+ */
+#ifndef ENABLE_APPLICATION_RECOVERY
+#define ENABLE_APPLICATION_RECOVERY 0
+#endif
+
 
 /**
  * ENABLE_IMPLICIT_TRANSACTIONS - call SCardBeginTransaction for all public API calls
@@ -118,6 +156,10 @@
 #define ENABLE_IMPLICIT_TRANSACTIONS 1
 #endif
 
+#if ENABLE_APPLICATION_RECOVERY && !ENABLE_IMPLICIT_TRANSACTIONS
+#error "ENABLE_APPLICATION_RECOVERY requires ENABLE_IMPLICIT_TRANSACTIONS"
+#endif
+
 /**
  * Platform specific definitions
