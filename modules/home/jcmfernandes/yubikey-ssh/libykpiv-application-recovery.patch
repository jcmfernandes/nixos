 }
 
+#if ENABLE_APPLICATION_RECOVERY
+/* Called after an operation failed. Returns YKPIV_OK if the PIV login was
+ * lost and has been restored, so the operation is worth retrying. */
+static ykpiv_rc _ykpiv_recover_application(ykpiv_state *state) {
+  ykpiv_rc res;
+  uint32_t serial = state->serial;
+  unsigned char data[256] = {0};
+  unsigned long recv_len = sizeof(data);
+  int total = -1, remaining = -1;
+
+  if (!state->pin || !serial || state->scp11_requested || !is_version_compatible(state, 5, 3, 0)) {
+    return YKPIV_GENERIC_ERROR;
+  }
+
+  int tries = state->tries;
+  res = _ykpiv_verify(state, NULL, NULL, false, false);
+  state->tries = tries;
+  if (res == YKPIV_OK) {
+    // Still logged in: the failure was genuine.
+    return YKPIV_GENERIC_ERROR;
+  }
+
+  // Whatever answered, select PIV and make sure it is the same device.
+  state->serial = 0;
+  res = _ykpiv_select_application(state, false);
+  if (res == YKPIV_OK && state->serial != serial) {
+    DBG("Recovery failed: card #%u, expected #%u", state->serial, serial);
+    res = YKPIV_GENERIC_ERROR;
+  }
+  if (res != YKPIV_OK) {
+    state->serial = serial;
+    return res;
+  }
+
+  // PIN metadata (key reference 0x80): tag 0x06 holds the total and
+  // remaining tries.
+  if ((res = _ykpiv_get_metadata(state, 0x80, data, &recv_len)) != YKPIV_OK) {
+    return res;
+  }
+  for (unsigned long i = 0; i + 2 <= recv_len; i += 2 + data[i + 1]) {
+    if (data[i] == 0x06 && data[i + 1] == 2 && i + 4 <= recv_len) {
+      total = data[i + 2];
+      remaining = data[i + 3];
+    }
+  }
+  if (total < 1 || remaining != total) {
+    DBG("Recovery skipped: %d of %d PIN tries left", remaining, total);
+    return YKPIV_GENERIC_ERROR;
+  }
+
+  size_t pin_len = strlen(state->pin);
+  if ((res = _ykpiv_verify(state, state->pin, &pin_len, false, false)) != YKPIV_OK) {
+    return res;
+  }
+  // De-authenticate always-authenticate keys by running an arbitrary command.
+  // Without this, those keys would sign with the cached PIN on the retry.
+  recv_len = sizeof(data);
+  return _ykpiv_fetch_object(state, YKPIV_OBJ_DISCOVERY, data, &recv_len);
+}
+#endif
