+#if ENABLE_IMPLICIT_TRANSACTIONS
+/* Whether re-verifying the cached PIN keeps failed attempts visible: a
+ * successful verification resets the retry counter, erasing attempts made
+ * by others since. Older devices can't report the total, so they keep the
+ * previous behavior. */
+static bool _ykpiv_pin_tries_intact(ykpiv_state *state) {
+  unsigned char data[256] = {0};
+  unsigned long recv_len = sizeof(data);
+  int total = -1, remaining = -1;
+
+  if (!is_version_compatible(state, 5, 3, 0)) {
+    return true;
+  }
+  // PIN metadata (key reference 0x80): tag 0x06 holds the total and
+  // remaining tries.
+  if (_ykpiv_get_metadata(state, 0x80, data, &recv_len) != YKPIV_OK) {
+    return false;
+  }
+  for (unsigned long i = 0; i + 2 <= recv_len; i += 2 + data[i + 1]) {
+    if (data[i] == 0x06 && data[i + 1] == 2 && i + 4 <= recv_len) {
+      total = data[i + 2];
+      remaining = data[i + 3];
+    }
+  }
+  if (total < 1 || remaining != total) {
+    DBG("Not re-verifying the cached PIN: %d of %d tries left", remaining, total);
+    return false;
+  }
+  return true;
+}
+#endif
+
